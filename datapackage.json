    {
      "name": "unidades_educativas_tiempo",
      "title": "Estadisticas anuales de estudiantes por unidad (CSV)",
      "description": "Serie temporal de matricula, promovidos, reprobados y abandono por sexo y anio para cada unidad educativa.",
      "type": "table",
      "path": "data/unidades_educativas_tiempo.csv",
      "scheme": "file",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "codigo_rue",
            "type": "integer",
            "description": "Codigo unico RUE de la unidad educativa."
          },
          {
            "name": "variable",
            "type": "string",
            "description": "Variable estadistica de estudiantes.",
            "categories": [
              "matricula",
              "promovidos",
              "reprobados",
              "abandono"
            ]
          },
          {
            "name": "sexo",
            "type": "string",
            "description": "Sexo reportado en la estadistica.",
            "categories": [
              "total",
              "hombre",
              "mujer"
            ]
          },
          {
            "name": "anio",
            "type": "integer",
            "description": "Anio del registro."
          },
          {
            "name": "valor",
            "type": "integer",
            "description": "Valor numerico de la variable en el anio y sexo indicados."
